# Lingkungan dan cache
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Data wajah — tidak pernah di-commit (PRD §11), kecuali README.md dan .gitkeep
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# Model — hanya checksums.txt yang di-commit
models/*.tflite
models/*.onnx
models/*.pt
models/*.part

# venv khusus ekspor YOLO (ultralytics + PyTorch + opencv-python) — terpisah dari .venv
.venv-yolo-export/

# Hasil eksperimen memuat citra wajah
results/
